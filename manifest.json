{
  "manifest_version": 2,
  "name": "Zotero Literature Notes",
  "version": "0.5.1",
  "description": "Literature note extraction for Zotero.",
  "homepage_url": "https://example.com/zotero-literature-notes",
  "author": "mjq",
  "applications": {
    "zotero": {
      "id": "zotero-literature-notes@mjq.local",
      "update_url": "https://example.com/zotero-literature-notes/update.json",
      "strict_min_version": "6.999",
      "strict_max_version": "10.*"
    }
  },
  "icons": {
    "48": "icons/icon.png",
    "96": "icons/icon.png"
  }
}
